int main (void)
    {   
        int valor;
        float temp;

        while (1){
        printf("Digite um valor inteiro entre 0 e 1023 para ser lido pelo sensor:\n");
        
        if ((scanf("%d", &valor) != 1) || (valor < 0 || valor > 1023)) {
